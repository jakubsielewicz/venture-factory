# venture-factory — environment template. Copy to `.env` and fill. NEVER commit `.env`.
# All keys are optional: the dynamic-injection scripts fail gracefully without them.

# --- Agent SDK (headless runs: automation/nightly_scout.py, automation/run_eval.py) ---
ANTHROPIC_API_KEY=

# --- Research data sources (G0 scout) ---
# Consumed by .claude/skills/demand-signals/scripts/pull_signals.py
DEMAND_SIGNALS_API_KEY=

# --- Financial benchmarks (G1/G3 analyst) ---
# Consumed by .claude/skills/unit-economics/scripts/pull_benchmarks.py
BENCHMARKS_API_KEY=

# --- Deploy / operate (G6) ---
# Prod/runtime secrets do NOT belong here in a real deployment — source them from a
# secret manager (cloud KMS, GitHub/Vercel/Supabase env). Listed only for local dev.
# STRIPE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# VERCEL_TOKEN=
