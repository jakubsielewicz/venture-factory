# ============================================================
# au-sme-compliance — Environment Variable Template
# ============================================================
# Copy this file to .env.local (never commit .env.local to git).
# All secrets are injected at runtime via environment variables.
# No secrets are hardcoded in source code (NFR-S3).
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=noreply@paycheck.com.au
EMAIL_FROM_NAME=PayCheck Compliance

# --- Application ---
NEXT_PUBLIC_APP_URL=https://app.paycheck.com.au
NODE_ENV=production

# --- Admin ---
# Separate secret for admin JWT signing (never share with frontend)
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# --- Rate Tables ---
# FWC rate table effective date (operator updates annually each July)
FWC_RATE_EFFECTIVE_DATE=2025-07-01
